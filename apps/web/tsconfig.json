{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@billscape/api": ["../../packages/api/src/index.ts"],
      "@billscape/core": ["../../packages/core/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src"]
}
